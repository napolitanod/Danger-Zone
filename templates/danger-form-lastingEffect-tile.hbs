<div class="tab active danger-part-group" data-tab="tile" data-group="sheet">
    <p class="notes">{{localize "DANGERZONE.type-form.tile.description"}}</p>
    <fieldset>
        <legend>{{localize "DANGERZONE.levels.label"}}</legend>
        <div class="form-group">
            <div class="form-fields">
                <select name="levels" value="{{data.levels}}" >
                    {{selectOptions options.LEVELSOPTIONS selected=data.levels localize=true}}
                </select>
            </div>
        </div>
    </fieldset>
    <div class="form-group slim">
        <label for="rotation">{{localize "DANGERZONE.type-form.tile.rotation.label"}}
            <span class="units">{{localize 'DANGERZONE.degrees'}}</span>
        </label>
        <div class="form-fields">
            <input type="number" required min="0" max="360" name="rotation" step="any" value={{#if data.rotation}}{{data.rotation}}{{else}}0{{/if}}>
        </div>
    </div>
    <div class="form-group slim">
        <label for="z">{{localize "DANGERZONE.type-form.tile.z.label"}}</label>
        <div class="form-fields">
            <input type="number" required  name="z" step="1" value={{data.z}}>
        </div>
    </div>
    <div class="form-group slim">
        <label for="locked">{{localize "DANGERZONE.locked.label"}}</label>
        <div class="form-fields">
            <input type="checkbox" data-dtype="Boolean" name="locked" {{checked data.locked}}>
        </div>
    </div>
    <div class="form-group slim">
        <label for="delay">{{localize "DANGERZONE.delay.label"}}</label>
        <div class="form-fields">
            <input type="number" required data-dtype="Number" name="delay" placeholder="{{localize "DANGERZONE.ms"}}" min="0" step="1" value={{data.delay}}>
        </div>
    </div>
    <div class="form-group {{#unless modules.taggerOn}}dz-hidden{{/unless}}">
        <label for="tag">{{localize "DANGERZONE.type-form.tile.tag.label"}}</label>
        <div class="form-fields">
            <input type="text" name="tag" placeholder="{{localize "DANGERZONE.type-form.tile.tag.description"}}"  value="{{data.tag}}">
        </div>
    </div>
</div>