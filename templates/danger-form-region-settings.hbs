<div class="tab active danger-part-group" data-tab="settings" data-group="sheet">
    <p class="notes">{{localize "DANGERZONE.type-form.region.description"}}</p>
    <div class="form-group">
        <label for="active">{{localize "DANGERZONE.type-form.region.active.label"}}</label>
        <div class="form-fields">
            <input type="checkbox" data-dtype="Boolean" name="active" {{checked data.active}}>
        </div>
    </div>    
    <fieldset>
        <legend>{{localize "DANGERZONE.levels.label"}}</legend>
        <div class="form-group">
            <div class="form-fields">
                <select name="levels" value="{{data.levels}}" >
                    {{selectOptions options.LEVELSOPTIONS selected=data.levels localize=true}}
                </select>
            </div>
        </div>
    </fieldset>
    <div class="form-group">
        <label for="name">{{localize "DANGERZONE.type-form.region.name.label"}}</label>
        <div class="form-fields">
            <input type="text" name="name" value="{{data.name}}">
        </div>
    </div>
    <div class="form-group">
        <label for="attachedToken">{{localize "DANGERZONE.type-form.region.attachedToken.label"}}
            <span class="dz-toolt" title="{{localize 'DANGERZONE.type-form.region.attachedToken.description'}}"><i class="fas fa-info-circle"></i></span>
        </label>
        <div class="form-fields">
            <select name="attachedToken" value="data.attachedToken" >  
                {{selectOptions options.REGION.ATTACHEDTOKEN selected=data.attachedToken localize=true}}
            </select>
        </div>
    </div>
    <fieldset>
        <legend>{{localize "DANGERZONE.type-form.region.restriction.label"}}</legend>
        <div class="form-group">
            <label for="restriction.enabled">{{localize "DANGERZONE.type-form.region.restriction.enabled.label"}}</label>
            <div class="form-fields">
                <input type="checkbox" data-dtype="Boolean" name="restriction.enabled" {{checked data.restriction.enabled}}>
            </div>
        </div>
        
        <div class="form-group">
            <label for="restriction.type">{{localize "DANGERZONE.type-form.region.restriction.type.label"}}</label>
            <div class="form-fields">
                <select name="restriction.type" value="data.restriction.type" >  
                    {{selectOptions options.REGION.RESTRICTIONTYPE selected=data.restriction.type localize=true}}
                </select>
            </div>
        </div>
        {{formField fields.restriction.fields.type value=source.restriction.type options=restrictionTypes classes="slim" rootId=rootId}}
        <div class="form-group">
            <label for="restriction.priority">{{localize "DANGERZONE.type-form.region.restriction.priority.label"}}</label>
            <div class="form-fields">
                <input type="number" required data-dtype="Number" name="restriction.priority" min="0" step="1" value={{#if data.restriction.priority}}{{data.restriction.priority}}{{else}}0{{/if}}>
            </div>
        </div>
    </fieldset>
    <div class="form-group">
        <label for="delay">{{localize "DANGERZONE.type-form.region.delay.label"}}</label>
        <div class="form-fields">
            <input type="number" required data-dtype="Number" name="delay" placeholder="{{localize "DANGERZONE.ms"}}" min="0" step="1" value={{#if data.delay}}{{data.delay}}{{else}}0{{/if}}>
        </div>
    </div>
    <div class="form-group {{#unless modules.taggerOn}}dz-hidden{{/unless}}">
        <label for="tag">{{localize "DANGERZONE.type-form.region.tag.label"}}</label>
        <div class="form-fields">
            <input type="text" name="tag" placeholder="{{localize "DANGERZONE.type-form.region.tag.description"}}"  value="{{data.tag}}">
        </div>
    </div>
</div>
   