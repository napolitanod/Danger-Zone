<div class="tab danger-part-group" data-tab="visual" data-group="sheet">
    <div class="form-group">
        <label for="file">{{localize random.visual.FILE}}</label>
        <div class="form-fields">
            <file-picker name="file" type="imagevideo" class="image" placeholder="{{localize random.visual.PLACEHOLDER}}" value="{{data.file}}"></file-picker>
        </div>
    </div>
    <div class="form-group">
        <label for="randomFile">{{localize random.visual.LABEL}}</label>
        <div class="form-fields">
            <input type="checkbox" data-dtype="Boolean" name="randomFile" {{checked data.randomFile}}>
        </div>
    </div>
    <div class="form-group inline slim">
        <label for="scale">{{localize "DANGERZONE.type-form.tile.scale.label"}}
            <span class="units">{{localize 'DANGERZONE.ratio'}}</span>
        </label>
        <div class="form-fields">
            <label for="scale">{{localize "DANGERZONE.x.label"}}</label>
            <input type="number" required name="scale" step="any" value={{data.scale}}>
            <label for="scaleY">{{localize "DANGERZONE.y.label"}}</label>
            <input type="number" required name="scaleY" step="any" value={{#if data.scaleY includeZero=true}}{{data.scaleY}}{{else}}{{data.scale}}{{/if}}>
        </div>
    </div>
    <div class="form-group">
        <label for="tint">{{localize "DANGERZONE.type-form.tile.color.label"}}</label>
        <div class="form-fields">
            <color-picker name="tint" value={{data.tint}}></color-picker>
        </div>
    </div>
    <div class="form-group">
        <label for="alpha">{{localize "DANGERZONE.type-form.tile.alpha.label"}}</label>
        <div class="form-fields">
            <range-picker name="alpha" value="{{data.alpha}}" min="0" max="1" step="0.05"></range-picker>
        </div>
    </div>
    <div class="form-group">
        <label for="hidden">{{localize "DANGERZONE.hidden.label"}}</label>
        <div class="form-fields">
            <input type="checkbox" data-dtype="Boolean" name="hidden" {{checked data.hidden}}>
        </div>
    </div>
    <fieldset>
        <legend>{{localize "DANGERZONE.type-form.tile.video.label"}}</legend>
         <div class="form-group">
            <label for="loop">{{localize "DANGERZONE.type-form.tile.loop.label"}}</label>
            <div class="form-fields">
                <input type="checkbox" data-dtype="Boolean" name="loop" {{checked data.loop}}>
            </div>
        </div>
        <div class="form-group">
            <label for="autoplay">{{localize "DANGERZONE.type-form.tile.autoplay.label"}}</label>
            <div class="form-fields">
                <input type="checkbox" data-dtype="Boolean" name="autoplay" {{checked data.autoplay}}>
            </div>
        </div>
        <div class="form-group">
            <label for="volume">{{localize "DANGERZONE.type-form.tile.volume.label"}}&nbsp;&nbsp;<i class="volume-icon fas fa-volume-down"></i></label>
            <div class="form-fields">
                <range-picker title="{{localize "DANGERZONE.type-form.tile.volume.label"}}" name="volume" value="{{data.volume}}" min="0" max="1" step="0.05"></range-picker>
            </div>
        </div>
    </fieldset>
</div>