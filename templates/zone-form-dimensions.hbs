
<div class="tab zone-group" data-tab="dimensions" data-group="sheet">
    <p class="notes">{{localize 'DANGERZONE.edit-form.boundary.description'}}</p>
    <div class="form-group" >
        <label>
            {{localize 'DANGERZONE.edit-form.region.label'}}
            <span class="dz-toolt" title="{{localize 'DANGERZONE.edit-form.region.description'}}"><i class="fas fa-info-circle"></i></span>
        </label>
        <div class="form-fields">
            <select data-action="region-change" name="scene.regionId" value="{{zone.scene.regionId}}">
                {{selectOptions regionOps selected=zone.scene.regionId localize=true}}
            </select>
        </div>
    </div>
    
    <div class="form-group">
        <label>
            {{localize 'DANGERZONE.edit-form.dimensions.label'}}
            <span class="dz-toolt" title="{{localize 'DANGERZONE.edit-form.dimensions.description'}}"><i class="fas fa-info-circle"></i></span>
        </label>
        <div class="form-fields {{#if hideLevels}} dz-hidden{{/if}}" id="dz-dimensions">
            <div class="form-group">
                <label>
                    {{localize 'DANGERZONE.edit-form.dimensions.bottom.label'}}
                </label>
                <div class="form-fields">
                    <input type="Number" name="dimensions.bottom" step="1" placeholder="{{defaultMinElevation}}" value={{zone.dimensions.bottom}}>
                </div>
            </div>
            <div class="form-group">
                <label>
                    {{localize 'DANGERZONE.edit-form.dimensions.top.label'}}
                </label>
                <div class="form-fields">
                    <input type="Number" name="dimensions.top" step="1" placeholder="{{defaultMaxElevation}}" value={{zone.dimensions.top}}>
                </div>
            </div>
        </div>
        <div class="form-fields {{#unless hideLevels}} dz-hidden{{/unless}}" id="dz-dimensions-region">
            <span>{{localize 'DANGERZONE.edit-form.dimensions.usesRegion.description'}}</span>
        </div>
    </div>
    <fieldset class="{{#if hideLevels}} dz-hidden{{/if}}" >
        <legend>{{localize 'DANGERZONE.edit-form.levels.label'}}
            <span class="dz-toolt" title="{{localize 'DANGERZONE.edit-form.levels.description'}}"><i class="fas fa-info-circle"></i></span>
        </legend>
        <div class="form-fields levels-select" id="dz-levels">
            <multi-select name="scene.levels" value="{{zone.scene.levels}}" >
                {{selectOptions levelOps selected=zone.scene.levels}}
            </multi-select>
        </div>
        <div class="form-fields {{#unless hideLevels}} dz-hidden{{/unless}}" id="dz-levels-region">
            <span>{{localize 'DANGERZONE.edit-form.levels.usesRegion.description'}}</span>
        </div>
    </fieldset> 
    <div class="form-group">
        <label>
            {{localize 'DANGERZONE.edit-form.bleed.label'}}
            <span class="dz-toolt" title="{{localize 'DANGERZONE.edit-form.bleed.description'}}"><i class="fas fa-info-circle"></i></span>
        </label>
        <div class="form-fields">
            <input type="checkbox" name="dimensions.bleed" {{checked zone.dimensions.bleed}} />
        </div>
    </div>
    <div class="form-group">
        <label>
            {{localize 'DANGERZONE.edit-form.stretch.label'}}
            <span class="dz-toolt" title="{{localize 'DANGERZONE.edit-form.stretch.description'}}"><i class="fas fa-info-circle"></i></span>
        </label>
        <div class="form-fields">
            <select name="dimensions.stretch" value="{{zone.dimensions.stretch}}">
                {{selectOptions options.STRETCH selected=zone.dimensions.stretch localize=true}}
            </select>
        </div>
    </div>
</div>