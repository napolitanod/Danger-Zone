<div class="tab standard-form zone-group">
    <div class="dz-hidden">
        <input type="text" value="{{data.id}}" name="id">
    </div>
    <p class="notes">{{localize "DANGERZONE.edit-form.extend.description"}}</p>
   <div class="form-group">
        <label for="zoneId">{{localize "DANGERZONE.edit-form.extension.zone.label"}}</label>
        <div class="form-fields">
            <select data-action="zone" name="zoneId" value="{{data.zoneId}}"> 
                <option value="" disabled>{{localize 'DANGERZONE.executor-form.zone.options.scene'}}</option>
                {{selectOptions zoneOps selected=data.zoneId localize=false}}
                <option value="" disabled>{{localize 'DANGERZONE.executor-form.zone.options.world'}}</option>
                {{selectOptions worldZoneOps selected=data.zoneId localize=false}}
                <option value="" disabled>{{localize 'DANGERZONE.executor-form.zone.options.danger'}}</option>
                {{selectOptions dangerOps selected=data.zoneId localize=false}}
            </select>   
        </div>
    </div>
    <p id="danger-zone-extension-interaction-warning" class="notes {{#if isSceneZone}}dz-hidden{{/if}}">{{localize "DANGERZONE.edit-form.extension.interaction.warning"}}</p>
    <div class="form-group">
        <label for="sequence">{{localize 'DANGERZONE.edit-form.extension.sequence.label'}}</label>
        <div class="form-fields">
            <select name="sequence" value="{{data.sequence}}"> 
                {{selectOptions options.ZONEEXTENSION.SEQUENCEOPTIONS selected=data.sequence localize=true}}
            </select>     
        </div>
    </div>
    <div class="form-group">
        <label for="interaction">{{localize 'DANGERZONE.edit-form.extension.interaction.label'}}</label>
        <div class="form-fields">
            <select data-action="interaction" name="interaction" value="{{data.interaction}}"> 
                {{selectOptions options.ZONEEXTENSION.INTERACTIONOPTIONS selected=data.interaction localize=true}}
            </select>     
        </div>
    </div>
    <p id="danger-zone-extension-interaction-shape" class="notes {{#unless (eq data.interaction "R")}}dz-hidden{{/unless}}">{{localize "DANGERZONE.edit-form.extension.interaction.shape"}}</p>
    
    <fieldset>
        <legend>{{localize 'DANGERZONE.edit-form.extension.trigger.label'}}</legend>
        <div class="form-group">
            <label>
                {{localize 'DANGERZONE.edit-form.extension.likelihood.label'}}
                <span class="dz-toolt" title="{{localize 'DANGERZONE.edit-form.extension.likelihood.description'}}"><i class="fas fa-info-circle"></i></span>
            </label>
            <div class="form-fields">
                <range-picker name="likelihood" value="{{#if data.likelihood}}{{data.likelihood}}{{else}}100{{/if}}" min="1" max="100" step="1"></range-picker>
            </div>
        </div>
        <div class="form-group">
            <label for="once">
                {{localize 'DANGERZONE.edit-form.extension.once.label'}}
                <span class="dz-toolt" title="{{localize 'DANGERZONE.edit-form.extension.once.description'}}"><i class="fas fa-info-circle"></i></span>
            </label>
            <div class="form-fields">
                <input type="checkbox" name="once" {{checked data.once}} />
            </div>
        </div>
        <div class="form-group slim">
            <label>
                {{localize 'DANGERZONE.delay.label'}}
                <span class="dz-toolt" title="{{localize 'DANGERZONE.edit-form.extension.delay.description'}}"><i class="fas fa-info-circle"></i></span>
            </label>
            <div class="form-fields">
                <label>
                    {{localize 'DANGERZONE.min.label'}}
                </label>
                <div class="form-fields">
                    <input type="Number" name="delay.min" min="0" max="30000" step="1" placeholder="{{localize "DANGERZONE.ms"}}" value={{data.delay.min}} required>
                </div>
                <label>
                    <span>{{localize 'DANGERZONE.max.label'}}</span>
                </label>
                <div class="form-fields">
                    <input type="Number" name="delay.max" min="0" max="30000" step="1" placeholder="{{localize "DANGERZONE.ms"}}" value={{data.delay.max}} required>
                </div>
            </div>
        </div>
    </fieldset>
    <fieldset id="danger-zone-extension-trigger-fields" class="{{#unless isTrigger}}dz-hidden{{/unless}}">
        <legend>{{localize 'DANGERZONE.edit-form.extension.target-settings.label'}}</legend>
        <div class="form-group">
            <label for="clear">
                {{localize 'DANGERZONE.edit-form.extension.clear.label'}}
                <span class="dz-toolt" title="{{localize 'DANGERZONE.edit-form.extension.clear.description'}}"><i class="fas fa-info-circle"></i></span>
            </label>
            <div class="form-fields">
                <input type="checkbox" name="clear" {{checked data.clear}} />
            </div>
        </div>
        <div class="form-group slim">
            <label for="boundary">
                {{localize 'DANGERZONE.edit-form.extension.boundary.label'}}
                <span class="dz-toolt" title="{{localize 'DANGERZONE.edit-form.extension.boundary.description'}}"><i class="fas fa-info-circle"></i></span>
            </label>
            <div class="form-fields">
                <input type="checkbox" name="boundary" {{checked data.boundary}} />
            </div>
        </div>
        <div class="form-group slim">
            <label for="levels">
                {{localize 'DANGERZONE.edit-form.extension.levels.label'}}
            </label>
            <div class="form-fields">
                <input type="checkbox" name="levels" {{checked data.levels}} />
            </div>
        </div>
        <div class="form-group slim">
            <label for="target">
                {{localize 'DANGERZONE.edit-form.extension.target.label'}}
                <span class="dz-toolt" title="{{localize 'DANGERZONE.edit-form.extension.target.description'}}"><i class="fas fa-info-circle"></i></span>
            </label>
            <div class="form-fields">
                <input type="checkbox" name="target" {{checked data.target}} />
            </div>
        </div>
        <div class="form-group slim">
            <label for="save">
                {{localize 'DANGERZONE.edit-form.extension.save.label'}}
                <span class="dz-toolt" title="{{localize 'DANGERZONE.edit-form.extension.save.description'}}"><i class="fas fa-info-circle"></i></span>
            </label>
            <div class="form-fields">
                <input type="checkbox" name="save" {{checked data.save}} />
            </div>
        </div>
        <div class="form-group slim">
            <label for="source">
                {{localize 'DANGERZONE.edit-form.extension.source.label'}}
                <span class="dz-toolt" title="{{localize 'DANGERZONE.edit-form.extension.source.description'}}"><i class="fas fa-info-circle"></i></span>
            </label>
            <div class="form-fields">
                <input type="checkbox" name="source" {{checked data.source}} />
            </div>
        </div>
    </fieldset>
</div> 